{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisputeLens evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "question", "filters", "expected_claims", "relevant_passage_ids", "answerability", "split", "review_status"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^E[0-9]{2}$"},
    "question": {"type": "string", "minLength": 1},
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus", "provider", "scheme"],
      "properties": {
        "corpus": {"enum": ["real", "fixture"]},
        "provider": {"type": ["string", "null"]},
        "scheme": {"type": ["string", "null"]},
        "region": {"type": ["string", "null"]},
        "as_of_date": {"type": ["string", "null"], "format": "date"}
      }
    },
    "expected_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "supporting_passage_ids"],
        "properties": {
          "claim_id": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "supporting_passage_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "relevant_passage_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "answerability": {"enum": ["answerable", "needs_clarification", "conflicting_sources", "not_in_sources"]},
    "split": {"enum": ["dev", "holdout"]},
    "review_status": {"enum": ["draft", "approved"]},
    "forbidden_claims": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
